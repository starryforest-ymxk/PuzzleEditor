{
  "apiVersion": "1.0.0",
  "scope": {
    "project": true
  },
  "commands": [
    {
      "op": "presentationNode.create",
      "alias": "choose",
      "graph": {
        "alias": "show"
      },
      "data": {
        "name": "Choose Path",
        "type": "Branch",
        "position": {
          "x": 0,
          "y": 180
        },
        "condition": {
          "type": "And",
          "children": [
            {
              "type": "ScriptRef",
              "scriptId": {
                "alias": "check"
              }
            },
            {
              "type": "Not",
              "operand": {
                "type": "Comparison",
                "operator": "==",
                "left": {
                  "type": "VariableRef",
                  "variableId": {
                    "alias": "flag"
                  },
                  "scope": "Global"
                },
                "right": {
                  "type": "Constant",
                  "value": true
                }
              }
            }
          ]
        }
      }
    },
    {
      "op": "presentation.create",
      "alias": "show",
      "data": {
        "name": "C4 Branch and Parallel",
        "description": "CLI presentation graph regression",
        "displayOrder": 0
      }
    },
    {
      "op": "presentation.create",
      "alias": "child",
      "data": {
        "name": "Shared Child",
        "displayOrder": 1
      }
    },
    {
      "op": "presentation.create",
      "alias": "leaf",
      "data": {
        "name": "Shared Leaf",
        "displayOrder": 2
      }
    },
    {
      "op": "script.create",
      "alias": "effect",
      "data": {
        "name": "Play Effect",
        "assetName": "PlayEffect",
        "category": "Performance"
      }
    },
    {
      "op": "script.create",
      "alias": "check",
      "data": {
        "name": "Check Flag",
        "assetName": "CheckFlag",
        "category": "Condition"
      }
    },
    {
      "op": "variable.create",
      "alias": "flag",
      "owner": {
        "type": "global"
      },
      "data": {
        "name": "Flag",
        "assetName": "Flag",
        "type": "boolean",
        "value": false
      }
    },
    {
      "op": "variable.create",
      "alias": "count",
      "owner": {
        "type": "stage",
        "ref": {
          "alias": "root"
        }
      },
      "data": {
        "name": "Count",
        "assetName": "Count",
        "type": "integer",
        "value": 0
      }
    },
    {
      "op": "puzzle.create",
      "alias": "door",
      "stage": {
        "alias": "root"
      },
      "data": {
        "name": "Door",
        "assetName": "Door"
      },
      "initialState": {
        "name": "Idle",
        "assetName": "Idle",
        "alias": "idle"
      }
    },
    {
      "op": "transition.create",
      "alias": "repeat",
      "fsm": {
        "puzzle": {
          "alias": "door"
        }
      },
      "from": {
        "alias": "idle"
      },
      "to": {
        "alias": "idle"
      },
      "data": {
        "name": "Replay",
        "priority": 0,
        "triggers": [
          {
            "type": "Always"
          }
        ],
        "presentation": {
          "type": "Graph",
          "graphId": {
            "alias": "show"
          }
        }
      }
    },
    {
      "op": "presentationNode.create",
      "alias": "yes",
      "graph": {
        "alias": "show"
      },
      "data": {
        "name": "True Wait",
        "type": "Wait",
        "duration": 0,
        "position": {
          "x": 250,
          "y": 20
        }
      }
    },
    {
      "op": "presentationNode.create",
      "alias": "no",
      "graph": {
        "alias": "show"
      },
      "data": {
        "name": "False Wait",
        "type": "Wait",
        "duration": 2,
        "position": {
          "x": 250,
          "y": 340
        }
      }
    },
    {
      "op": "presentationNode.create",
      "alias": "both",
      "graph": {
        "alias": "show"
      },
      "data": {
        "name": "Parallel Paths",
        "type": "Parallel",
        "position": {
          "x": 500,
          "y": 180
        }
      }
    },
    {
      "op": "presentationNode.create",
      "alias": "effectCall",
      "graph": {
        "alias": "show"
      },
      "data": {
        "name": "Play Effect",
        "type": "PresentationNode",
        "position": {
          "x": 750,
          "y": 20
        },
        "presentation": {
          "type": "Script",
          "scriptId": {
            "alias": "effect"
          },
          "parameters": [
            {
              "paramName": "Payload",
              "source": {
                "type": "Constant",
                "value": {
                  "alias": "choose",
                  "value": false
                }
              }
            },
            {
              "paramName": "Iterations",
              "kind": "Temporary",
              "tempVariable": {
                "name": "Iterations",
                "type": "integer"
              },
              "source": {
                "type": "VariableRef",
                "variableId": {
                  "alias": "count"
                },
                "scope": "StageLocal"
              }
            }
          ]
        }
      }
    },
    {
      "op": "presentationNode.create",
      "alias": "childCall",
      "graph": {
        "alias": "show"
      },
      "data": {
        "name": "Shared Child",
        "type": "PresentationNode",
        "position": {
          "x": 750,
          "y": 340
        },
        "presentation": {
          "type": "Graph",
          "graphId": {
            "alias": "child"
          }
        }
      }
    },
    {
      "op": "presentationNode.create",
      "alias": "leafCall",
      "graph": {
        "alias": "child"
      },
      "data": {
        "name": "Shared Leaf",
        "type": "PresentationNode",
        "position": {
          "x": 0,
          "y": 0
        },
        "presentation": {
          "type": "Graph",
          "graphId": {
            "alias": "leaf"
          }
        }
      }
    },
    {
      "op": "presentationNode.create",
      "alias": "leafWait",
      "graph": {
        "alias": "leaf"
      },
      "data": {
        "name": "Leaf Wait",
        "type": "Wait",
        "duration": 0.5,
        "position": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "op": "presentation.setStart",
      "graph": {
        "alias": "show"
      },
      "node": {
        "alias": "choose"
      }
    },
    {
      "op": "presentationEdge.connect",
      "graph": {
        "alias": "show"
      },
      "from": {
        "alias": "choose"
      },
      "slot": "true",
      "to": {
        "alias": "yes"
      },
      "style": {
        "fromSide": "right",
        "toSide": "left"
      }
    },
    {
      "op": "presentationEdge.connect",
      "graph": {
        "alias": "show"
      },
      "from": {
        "alias": "choose"
      },
      "slot": "false",
      "to": {
        "alias": "no"
      },
      "style": {
        "fromSide": "bottom",
        "toSide": "left"
      }
    },
    {
      "op": "presentationEdge.connect",
      "graph": {
        "alias": "show"
      },
      "from": {
        "alias": "yes"
      },
      "slot": "next",
      "to": {
        "alias": "both"
      }
    },
    {
      "op": "presentationEdge.connect",
      "graph": {
        "alias": "show"
      },
      "from": {
        "alias": "no"
      },
      "slot": "next",
      "to": {
        "alias": "both"
      }
    },
    {
      "op": "presentationEdge.connect",
      "graph": {
        "alias": "show"
      },
      "from": {
        "alias": "both"
      },
      "slot": 0,
      "to": {
        "alias": "effectCall"
      }
    },
    {
      "op": "presentationEdge.connect",
      "graph": {
        "alias": "show"
      },
      "from": {
        "alias": "both"
      },
      "slot": 1,
      "to": {
        "alias": "childCall"
      }
    },
    {
      "op": "stage.update",
      "target": {
        "alias": "root"
      },
      "changes": {
        "onEnterPresentation": {
          "type": "Graph",
          "graphId": {
            "alias": "show"
          }
        }
      }
    }
  ]
}
